# Web app (public values — safe in the browser). Lovable fills these automatically.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Server-only (set as secrets in hosting, never in browser code)
LOVABLE_API_KEY=your-lovable-ai-key
# Optional: route scans through the Python FastAPI service
PYTHON_CLASSIFIER_URL=
PYTHON_CLASSIFIER_API_KEY=
